# LASO-Web reads this simple KEY=value file from its working directory.
# Keep real credentials in a protected deployment-local file.
LASO_URL=http://127.0.0.1:8080
LASO_WEB_BIND=127.0.0.1
LASO_WEB_PORT=8081
# Required when binding to a non-loopback address. Use a long random value;
# remote access should additionally use TLS and a reverse proxy.
# LASO_WEB_PASSWORD=
# Also required for a non-loopback bind; comma-separated Host header allowlist.
# LASO_WEB_ALLOWED_HOSTS=laso.example.invalid
# Optional bearer credential sent only from the server to LASO.
# LASO_TOKEN=
