server {
    listen 443 ssl;
    server_name laso.example.invalid;

    # Configure certificates using your deployment's approved certificate flow.
    ssl_certificate /etc/letsencrypt/live/laso.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/laso.example.invalid/privkey.pem;
    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 15s;
    }
}
